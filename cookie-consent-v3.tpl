___SANDBOXED_JS_FOR_WEB_TEMPLATE___

// Sandboxed JavaScript for the GTM tag template, not a Webflow script.
const setDefaultConsentState = require('setDefaultConsentState');
const updateConsentState = require('updateConsentState');
const callInWindow = require('callInWindow');
const createQueue = require('createQueue');

const denied = {
  analytics_storage: 'denied',
  ad_storage: 'denied',
  ad_user_data: 'denied',
  ad_personalization: 'denied',
  functionality_storage: 'denied',
  personalization_storage: 'denied',
  security_storage: 'granted'
};
setDefaultConsentState(denied);

const state = callInWindow('CookieConsentV3.getState');
if (state && state.apiVersion === 3 && state.valid === true) {
  updateConsentState({
    analytics_storage: state.analytics === true ? 'granted' : 'denied',
    ad_storage: state.marketing === true ? 'granted' : 'denied',
    ad_user_data: state.marketing === true ? 'granted' : 'denied',
    ad_personalization: state.marketing === true ? 'granted' : 'denied',
    functionality_storage: state.functional === true ? 'granted' : 'denied',
    personalization_storage: 'denied',
    security_storage: 'granted'
  });
  callInWindow('CookieConsentV3.onBeforeReload', function () {
    updateConsentState(denied);
  });
  const push = createQueue('dataLayer');
  // Native consent updates are processed before this queued event.
  push({
    event: 'cc_v3_ready',
    functional: state.functional === true,
    marketing: state.marketing === true,
    analytics: state.analytics === true
  });
}
data.gtmOnSuccess();


